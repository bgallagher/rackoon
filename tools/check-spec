#!/usr/bin/env python3
"""Validate the shared spec: JSON parses, every command has fixtures, every fixture has expected output."""
import json
import re
import sys
from pathlib import Path

spec = Path(__file__).resolve().parent.parent / "spec"
errors = []

def load(name):
    try:
        return json.loads((spec / name).read_text())
    except Exception as e:
        errors.append(f"{name}: {e}")
        return {}

load("models.schema.json")
load("attention-rules.json")
commands = load("commands.json").get("commands", [])

ids = [c.get("id") for c in commands]
if len(ids) != len(set(ids)):
    errors.append("commands.json: duplicate command ids")

for c in commands:
    cid = c.get("id")
    for key in ("id", "script", "timeoutSeconds"):
        if key not in c:
            errors.append(f"commands.json: {cid or '?'} missing '{key}'")
    if c.get("kind") in ("action", "stream", "interactive", "query", "template"):
        continue  # parameterised actions, streams and terminal commands: no parsed output, so no fixtures
    outs = sorted((spec / "fixtures" / str(cid)).glob("*.out.txt"))
    if not outs:
        errors.append(f"fixtures/{cid}: no fixtures")
    for out in outs:
        expected = out.with_name(out.name.replace(".out.txt", ".expected.json"))
        if not expected.exists():
            errors.append(f"{expected.relative_to(spec)}: missing")
        else:
            try:
                json.loads(expected.read_text())
            except Exception as e:
                errors.append(f"{expected.relative_to(spec)}: {e}")

# Fixtures that are not command output (licence keys, see spec/licence-key.md) are checked separately below.
NON_COMMAND_FIXTURES = {"licence"}
for d in (spec / "fixtures").iterdir():
    if d.is_dir() and d.name not in ids and d.name not in NON_COMMAND_FIXTURES:
        errors.append(f"fixtures/{d.name}: no matching command in commands.json")

# Licence key fixtures: every key has an expected answer, every answer parses, the TEST key pair says so.
licence_dir = spec / "fixtures" / "licence"
if licence_dir.is_dir():
    for key in sorted(licence_dir.glob("*.key.txt")):
        expected = key.with_name(key.name.replace(".key.txt", ".expected.json"))
        if not expected.exists():
            errors.append(f"fixtures/licence/{expected.name}: missing")
        else:
            try:
                e = json.loads(expected.read_text())
                if "valid" not in e or (e["valid"] and "payload" not in e) or (not e["valid"] and "error" not in e):
                    errors.append(f"fixtures/licence/{expected.name}: needs valid plus payload or error")
            except Exception as ex:
                errors.append(f"fixtures/licence/{expected.name}: {ex}")
    pair = licence_dir / "test-keypair.json"
    try:
        if "TEST" not in json.loads(pair.read_text()).get("note", ""):
            errors.append("fixtures/licence/test-keypair.json: must say it is a TEST key pair")
    except Exception as ex:
        errors.append(f"fixtures/licence/test-keypair.json: {ex}")

# Command library (the Commands tab): shape, unique ids, known groups, every mutating entry has a dry-run preview.
library = load("command-library.json")
lib_groups = library.get("groups", [])
lib_ids = []
for c in library.get("commands", []):
    cid = c.get("id", "?")
    lib_ids.append(cid)
    for key in ("id", "title", "group", "summary", "script", "risk"):
        if not c.get(key):
            errors.append(f"command-library.json: {cid} missing '{key}'")
    if c.get("group") not in lib_groups:
        errors.append(f"command-library.json: {cid} has unknown group {c.get('group')!r}")
    if c.get("risk") not in ("read", "mutate"):
        errors.append(f"command-library.json: {cid} risk must be read or mutate")
    if c.get("risk") == "mutate" and not c.get("preview"):
        errors.append(f"command-library.json: {cid} changes the server, so it needs a read-only 'preview'")
    if c.get("risk") == "read" and (c.get("preview") or c.get("warning")):
        errors.append(f"command-library.json: {cid} is read-only, so it has no preview or warning")
    if c.get("root") and "$S" not in c.get("script", ""):
        errors.append(f"command-library.json: {cid} is marked root but its script never uses $S")
    used = set(re.findall(r"\{([a-z]+)\}", c.get("script", ""))) - {"Names", "Status", "Image"}
    declared = {p.get("id") for p in c.get("params", [])}
    if used != declared:
        errors.append(f"command-library.json: {cid} placeholders {sorted(used)} do not match params {sorted(declared)}")
    if c.get("needs") and not re.fullmatch(r"[a-z0-9-]+", c["needs"]):
        errors.append(f"command-library.json: {cid} has an unsafe 'needs' value")
if len(lib_ids) != len(set(lib_ids)):
    errors.append("command-library.json: duplicate ids")

# Terminal themes (app resource, same rules as ThemeCatalog.validate in Swift)
import re
hexre = re.compile(r"^#[0-9A-Fa-f]{6}$")
themes_path = spec.parent / "apple" / "Apps" / "RackoonMac" / "Resources" / "themes.json"
try:
    themes = json.loads(themes_path.read_text())
except Exception as e:
    themes = []
    errors.append(f"themes.json: {e}")
tids = [t.get("id") for t in themes]
if len(tids) != len(set(tids)):
    errors.append("themes.json: duplicate ids")
if "rackoon-dark" not in tids:
    errors.append("themes.json: default theme rackoon-dark is missing")
for t in themes:
    tid = t.get("id", "?")
    if t.get("appearance") not in ("dark", "light"):
        errors.append(f"themes.json: {tid}: appearance must be dark or light")
    for key in ("background", "foreground"):
        if not hexre.match(str(t.get(key, ""))):
            errors.append(f"themes.json: {tid}: bad {key}")
    for key in ("cursor", "selection"):
        if key in t and not hexre.match(str(t[key])):
            errors.append(f"themes.json: {tid}: bad {key}")
    ansi = t.get("ansi", [])
    if len(ansi) != 16 or not all(hexre.match(str(c)) for c in ansi):
        errors.append(f"themes.json: {tid}: needs exactly 16 valid ANSI colours")

# Feature parity matrix (docs/parity.md): every feature has an entry for every platform; done names its tests (or says
# why it has none), planned and na say why; every spec command belongs to a feature. Whether the named tests really ran
# and passed is tools/check-parity's job, from each platform's JUnit report.
PLATFORMS = ["mac", "android", "ios", "web"]
features_doc = load("features.json")
features = features_doc.get("features", [])
if features_doc and features_doc.get("platforms") != PLATFORMS:
    errors.append(f"features.json: platforms must be {PLATFORMS}")
feature_ids = [f.get("id") for f in features]
if len(feature_ids) != len(set(feature_ids)):
    errors.append("features.json: duplicate feature ids")
idre = re.compile(r"^[a-z][a-z0-9-]*(\.[a-z0-9-]+)*$")
testre = re.compile(r"^[A-Za-z_][\w.]*(/[\w()\[\] ,.-]+)?$")
claimed = {}
untested = 0
for f in features:
    fid = f.get("id") or "?"
    if not idre.match(fid):
        errors.append(f"features.json: bad feature id {fid!r}")
    if not f.get("title"):
        errors.append(f"features.json: {fid} has no title")
    for cid in f.get("commands", []):
        if cid not in ids:
            errors.append(f"features.json: {fid} names unknown command {cid!r}")
        claimed.setdefault(cid, []).append(fid)
    entries = f.get("platforms", {})
    if sorted(entries) != sorted(PLATFORMS):
        errors.append(f"features.json: {fid} needs exactly one entry per platform {PLATFORMS}, has {sorted(entries)}")
    for p, e in entries.items():
        status = e.get("status")
        where = f"features.json: {fid}/{p}"
        if status not in ("done", "planned", "na"):
            errors.append(f"{where}: status must be done, planned or na")
        elif status == "done":
            tests = e.get("tests", [])
            if not tests and not e.get("untested"):
                errors.append(f"{where}: done needs 'tests', or an 'untested' reason")
            for t in tests:
                if not testre.match(t):
                    errors.append(f"{where}: test {t!r} is not Class or Class/method")
            if e.get("untested"):
                untested += 1
            if e.get("reason"):
                errors.append(f"{where}: a done entry has no 'reason' (use 'untested' for a missing test)")
        elif not str(e.get("reason", "")).strip():
            errors.append(f"{where}: {status} needs a 'reason'")
# Shared behaviour scenarios (spec/scenarios/*.json): each core runs a file only while its feature is done there, so
# the feature must exist; a file without a feature runs on every core.
scenario_subjects = {}
for path in sorted((spec / "scenarios").glob("*.json")):
    name = f"scenarios/{path.name}"
    try:
        doc = json.loads(path.read_text())
    except Exception as e:
        errors.append(f"{name}: {e}")
        continue
    if doc.get("feature") is not None and doc["feature"] not in feature_ids:
        errors.append(f"{name}: unknown feature {doc['feature']!r}")
    if not re.fullmatch(r"[a-z][a-z0-9_]*", str(doc.get("subject", ""))):
        errors.append(f"{name}: needs a snake_case 'subject'")
    elif doc["subject"] in scenario_subjects:
        errors.append(f"{name}: subject {doc['subject']!r} is already used by {scenario_subjects[doc['subject']]}")
    else:
        scenario_subjects[doc["subject"]] = name
    if not doc.get("about"):
        errors.append(f"{name}: needs an 'about' saying what is checked")
    cases = doc.get("cases")
    if not isinstance(cases, list) or not cases:
        errors.append(f"{name}: needs a non-empty 'cases' list")
        continue
    names = [c.get("name") for c in cases if isinstance(c, dict)]
    if len(names) != len(cases) or not all(names):
        errors.append(f"{name}: every case needs a 'name'")
    elif len(names) != len(set(names)):
        errors.append(f"{name}: duplicate case names")

# Integration lab checks (spec/integration/checks.json, run against test/lab by every transport): same feature gating.
integration = load("integration/checks.json")
check_ids = [c.get("id") for c in integration.get("checks", [])]
if integration and not check_ids:
    errors.append("integration/checks.json: no checks")
if len(check_ids) != len(set(check_ids)):
    errors.append("integration/checks.json: duplicate check ids")
for c in integration.get("checks", []):
    cid = c.get("id") or "?"
    if not re.fullmatch(r"[a-z][a-z0-9_]*", cid):
        errors.append(f"integration/checks.json: bad check id {cid!r}")
    if c.get("feature") not in feature_ids:
        errors.append(f"integration/checks.json: {cid} names unknown feature {c.get('feature')!r}")
    if not c.get("about"):
        errors.append(f"integration/checks.json: {cid} needs an 'about'")

for cid in ids:
    if cid not in claimed:
        errors.append(f"features.json: command {cid!r} belongs to no feature")
    elif len(claimed[cid]) > 1:
        errors.append(f"features.json: command {cid!r} is claimed by {claimed[cid]}")

if errors:
    print("\n".join(errors))
    sys.exit(1)
print(f"spec ok: {len(commands)} command(s), {len(themes)} theme(s), {len(features)} feature(s)"
      + (f", {untested} done without a test" if untested else ""))
