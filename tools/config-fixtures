def write(name: str, data: bytes | str) -> None:
    path = OUT / name
    path.write_bytes(data if isinstance(data, bytes) else data.encode())


def expected(name: str, value: dict[str, object]) -> None:
    write(f"{name}.expected.json", json.dumps(value, indent=2, ensure_ascii=False) + "\n")


def pretty(obj: object) -> str:
    return json.dumps(obj, indent=2, ensure_ascii=False) + "\n"


def canonical(obj: dict[str, object], **kw: bool) -> dict[str, object]:
    return ct.document_json(ct.read_document(obj, **kw), **kw)  # type: ignore[arg-type]


def main() -> None:
    OUT.mkdir(parents=True, exist_ok=True)
    for old in OUT.iterdir():
        old.unlink()

    # Plain documents as each platform writes them.
    for name, doc in (("mac-plain", MAC), ("android-plain", ANDROID), ("ios-plain", IOS), ("web-plain", WEB)):
        write(f"{name}.rackoon", pretty(doc))
        expected(name, {"document": canonical(doc, secrets=False)})

    # A plain file never carries secrets: a reader drops them.
    with_secrets = {**ANDROID, "secrets": {"srv-vps": {"password": "made-up"}}}
    write("plain-with-secrets.rackoon", pretty(with_secrets))
    expected("plain-with-secrets", {"document": canonical(ANDROID, secrets=False)})

    # Unknown fields from a later version 1 are ignored; wrong types and unknown preferences are dropped.
    later = json.loads(json.dumps(IOS))
    later["futurePart"] = {"anything": [1, 2, 3]}
    later["servers"][0]["futureField"] = "ignored"
    later["preferences"].update({"futurePreference": True, "readOnly": "yes", "terminalFontSize": 99,
                                 "autoReadOnly": "sometimes"})
    later["signIn"]["srv-pi"] = {"method": "passkey"}
    later["serverSettings"]["no-such-server"] = {"icons": {"x": "y"}}
    write("later-version-1.rackoon", pretty(later))
    trimmed = json.loads(json.dumps(IOS))
    del trimmed["preferences"]["readOnly"]
    del trimmed["signIn"]["srv-pi"]
    expected("later-version-1", {"document": canonical(trimmed, secrets=False)})

    write("version-2.rackoon", pretty({**IOS, "version": 2}))
    expected("version-2", {"error": "newerVersion"})
    write("not-rackoon.rackoon", pretty({"servers": []}))
    expected("not-rackoon", {"error": "notRackoonConfig"})
    bad = json.loads(json.dumps(IOS))
    bad["servers"][0]["host"] = "-oProxyCommand=touch /tmp/pwned"
    write("dash-host.rackoon", pretty(bad))
    expected("dash-host", {"error": "damaged"})
    twice = json.loads(json.dumps(ANDROID))
    twice["servers"][1]["id"] = "srv-pi"
    write("duplicate-id.rackoon", pretty(twice))
    expected("duplicate-id", {"error": "damaged"})

    # Encrypted: the Mac document with secrets, under the published TEST passphrase.
    full = {**MAC, "secrets": SECRETS}
    doc = ct.read_document(full, secrets=True)
    sealed = ct.encrypted_file(doc, PASSPHRASE, Seeded("encrypted"))
    write("encrypted.rackoon", sealed)
    expected("encrypted", {"passphrase": PASSPHRASE, "document": ct.document_json(doc)})
    write("encrypted-wrong-passphrase.rackoon", sealed)
    expected("encrypted-wrong-passphrase", {"passphrase": "correct horse battery stapl", "error": "wrongPassphrase"})
    write("encrypted-no-passphrase.rackoon", sealed)
    expected("encrypted-no-passphrase", {"error": "needsPassphrase"})
    tampered = json.loads(sealed)
    ct_bytes = bytearray(base64.b64decode(tampered["ciphertext"]))
    ct_bytes[10] ^= 1
    tampered["ciphertext"] = base64.b64encode(bytes(ct_bytes)).decode()
    write("encrypted-tampered.rackoon", pretty(tampered))
    expected("encrypted-tampered", {"passphrase": PASSPHRASE, "error": "wrongPassphrase"})
    slow = json.loads(sealed)
    slow["kdf"]["iterations"] = 50_000_000
    write("encrypted-huge-iterations.rackoon", pretty(slow))
    expected("encrypted-huge-iterations", {"passphrase": PASSPHRASE, "error": "damaged"})

    # QR: the same document; secrets and custom icons never go into a QR.
    rnd = Seeded("qr")
    code, parts = ct.qr_export(doc, rnd, max_part_bytes=300)
    qr_doc = ct.document_json(ct.read_document(full, secrets=False, custom_icons=False), secrets=False,
                              custom_icons=False)
    write("mac.qr.json", pretty({"parts": parts}))
    expected("mac", {"unlockCode": ct.format_unlock_code(code), "document": qr_doc})
    write("mac-typed-code.qr.json", pretty({"parts": list(reversed(parts))}))
    expected("mac-typed-code", {"unlockCode": code.lower().replace("0", "o").replace("1", "l"), "document": qr_doc})
    write("mac-wrong-code.qr.json", pretty({"parts": parts}))
    wrong = code[:-1] + ("0" if code[-1] != "0" else "1")
    expected("mac-wrong-code", {"unlockCode": wrong, "error": "wrongUnlockCode"})
    print(f"wrote {len(list(OUT.iterdir()))} files to {OUT.relative_to(ROOT)}; QR: {len(parts)} parts, code {code}")


if __name__ == "__main__":
    main()
