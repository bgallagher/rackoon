class Seeded:
    """Deterministic bytes: sha256(seed | counter) blocks."""

    def __init__(self, seed: str) -> None:
        self.seed, self.counter, self.buffer = seed.encode(), 0, b""

    def __call__(self, n: int) -> bytes:
        while len(self.buffer) < n:
            self.buffer += hashlib.sha256(self.seed + self.counter.to_bytes(8, "big")).digest()
            self.counter += 1
        out, self.buffer = self.buffer[:n], self.buffer[n:]
        return out


def wire(*parts: bytes) -> str:
    return base64.b64encode(b"".join(struct.pack(">I", len(p)) + p for p in parts)).decode()


def made_up(seed: str, n: int) -> bytes:
    return Seeded(seed)(n)


