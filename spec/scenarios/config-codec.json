{
 "feature": "config.format",
 "subject": "config_codec",
 "about": "spec/config-transfer.md, the codec: Base45 (fn base45: hex <-> text, or error), unlock code normalisation (fn unlockCode: input -> expect, null when refused), QR part split (fn qrSplit) and collection (fn qrCollect: the parts in scan order -> the payload's hex, or the error code; the payload must start with 0x01 and be at least 45 bytes), host key fingerprints (fn fingerprint) and reading a document (fn readDocument: source plain, encrypted or qr -> the canonical document, or the error code).",
 "cases": [
  {
   "name": "base45 RFC 9285: AB",
   "fn": "base45",
   "hex": "4142",
   "text": "BB8"
  },
  {
   "name": "base45 RFC 9285: Hello!!",
   "fn": "base45",
   "hex": "48656c6c6f2121",
   "text": "%69 VD92EX0"
  },
  {
   "name": "base45 RFC 9285: base-45",
   "fn": "base45",
   "hex": "626173652d3435",
   "text": "UJCLQE7W581"
  },
  {
   "name": "base45 RFC 9285: ietf!",
   "fn": "base45",
   "hex": "6965746621",
   "text": "QED8WEX0"
  },
  {
   "name": "base45 empty",
   "fn": "base45",
   "hex": "",
   "text": ""
  },
  {
   "name": "base45 zero and high bytes",
   "fn": "base45",
   "hex": "00ff01",
   "text": "U5010"
  },
  {
   "name": "base45 refuses value over 65535",
   "fn": "base45",
   "text": "GGW",
   "error": true
  },
  {
   "name": "base45 refuses lower case",
   "fn": "base45",
   "text": "bb8",
   "error": true
  },
  {
   "name": "base45 refuses one symbol left over",
   "fn": "base45",
   "text": "BB8A",
   "error": true
  },
  {
   "name": "base45 refuses last pair over 255",
   "fn": "base45",
   "text": "BB8:Z",
   "error": true
  },
