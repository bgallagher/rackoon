{
  "feature": "security.cves",
  "subject": "debian_version",
  "about": "dpkg's version ordering (epoch, upstream, revision; '~' sorts before everything, even the end; letters before other characters; digit runs compare as numbers). 'expect' is the sign of compare(a, b): -1, 0 or 1.",
  "cases": [
    {
      "name": "revision numbers compare as numbers",
      "a": "2.39-0ubuntu8.3",
      "b": "2.39-0ubuntu8.10",
      "expect": -1
    },
    {
      "name": "upstream first",
      "a": "1.0-9",
      "b": "1.1-1",
      "expect": -1
    },
    {
      "name": "an epoch beats everything",
      "a": "1:1.0",
      "b": "2.0",
      "expect": 1
    },
    {
      "name": "epoch 0 is no epoch",
      "a": "0:1.0",
      "b": "1.0",
      "expect": 0
    },
    {
      "name": "no revision equals revision 0",
      "a": "1.0",
      "b": "1.0-0",
      "expect": 0
    },
    {
      "name": "tilde sorts before the end",
      "a": "1.0~rc1",
      "b": "1.0",
      "expect": -1
    },
    {
      "name": "double tilde before single",
      "a": "1.2.3~~",
      "b": "1.2.3~",
      "expect": -1
    },
    {
      "name": "plus sorts after the end",
      "a": "1.0",
      "b": "1.0+b1",
      "expect": -1
    },
    {
      "name": "letters before other characters",
      "a": "1.0a",
      "b": "1.0+",
      "expect": -1
    },
    {
      "name": "a dot after the end is greater",
      "a": "1.0.",
      "b": "1.0",
      "expect": 1
    },
    {
      "name": "equal",
      "a": "3.0.13-0ubuntu3.4",
      "b": "3.0.13-0ubuntu3.4",
      "expect": 0
    },
    {
      "name": "ubuntu security revision",
      "a": "3.0.13-0ubuntu3.1",
      "b": "3.0.13-0ubuntu3.4",
      "expect": -1
    },
    {
      "name": "debian security update",
      "a": "7.88.1-10+deb12u5",
      "b": "7.88.1-10+deb12u8",
      "expect": -1
    },
    {
      "name": "ubuntu suffix is newer than debian's",
      "a": "1.0-1ubuntu1",
      "b": "1.0-1",
      "expect": 1
    },
    {
      "name": "dfsg suffix",
      "a": "1:1.3.dfsg-3.1ubuntu2",
      "b": "1:1.3-1",
      "expect": 1
    },
    {
      "name": "leading zeros do not count",
      "a": "1.002",
      "b": "1.2",
      "expect": 0
    },
    {
      "name": "hyphens in upstream: the last one starts the revision",
      "a": "1.0-beta-2",
      "b": "1.0-beta-10",
      "expect": -1
    }
  ]
}
