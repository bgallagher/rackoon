{
 "feature": "config.format",
 "subject": "config_merge",
 "about": "spec/config-transfer.md, importing: each case reads 'local' (this device's configuration) and 'incoming' (read as 'source': plain, encrypted or qr) on 'platform', plans the import (servers in the document's order with their kind, local id, how they matched and the changed fields; host keys with their status; the changed preference ids, sorted; whether Read-only turns on; the local servers Replace everything removes; the incoming ids that bring a secret), applies 'choices' (replace, keep: incoming ids, applyPreferences, trustHostKeys; defaults false, [], true, true) and compares the canonical result.",
 "cases": [
  {
   "name": "a new server is added after the local ones, with its sign-in and settings",
   "platform": "ios",
   "source": "encrypted",
   "local": {
    "format": "rackoon-config",
    "version": 1,
    "servers": [
     {
      "id": "a",
      "name": "alpha",
      "host": "alpha.lan",
      "user": "root"
     }
    ]
   },
   "incoming": {
    "format": "rackoon-config",
    "version": 1,
    "servers": [
     {
      "id": "b",
      "name": "beta",
      "host": "beta.lan",
      "user": "admin",
      "port": 2222
     }
    ],
    "signIn": {
     "b": {
      "method": "password"
     }
    },
    "serverSettings": {
     "b": {
      "vulnerabilityLookup": true
     }
    },
    "secrets": {
     "b": {
      "password": "made-up"
     }
    }
   },
   "plan": {
    "servers": [
     {
      "id": "b",
      "kind": "new"
     }
    ],
    "hostKeys": [],
    "preferences": [],
    "readOnlyTurnsOn": false,
    "removed": [
     "a"
    ],
    "secrets": [
     "b"
    ]
   },
   "result": {
    "format": "rackoon-config",
    "version": 1,
    "servers": [
     {
      "id": "a",
      "name": "alpha",
      "host": "alpha.lan",
      "user": "root"
     },
     {
      "id": "b",
      "name": "beta",
      "host": "beta.lan",
      "user": "admin",
      "port": 2222
     }
    ],
    "hostKeys": [],
    "signIn": {
     "b": {
      "method": "password"
     }
    },
    "preferences": {},
    "serverSettings": {
     "b": {
      "vulnerabilityLookup": true
     }
    },
    "secrets": {
     "b": {
      "password": "made-up"
     }
    }
   }
  },
