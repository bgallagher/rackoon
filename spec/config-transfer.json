{
  "about": "Every setting and data file a Rackoon app saves, and whether a config transfer (spec/config-transfer.md) carries it. 'part' is where it goes in the document; 'transfer: false' needs a 'reason'. A preference's 'type' (bool, int, string) and its optional 'values', 'min', 'max' and 'maxLength' are checked when a document is read; a value that fails is dropped. Keys are '<store>:<name>': 'defaults' is UserDefaults (Mac, iOS), 'prefs' is Android SharedPreferences, a web key names its file under <data>. Paths are under each app's data folder unless they start with '~'. tools/check-spec fails if an app saves a preference key or a .json file this catalog does not name, so a new setting cannot ship without deciding whether it transfers.",
  "platforms": ["mac", "android", "ios", "web"],
  "settings": [
    {"id": "theme", "part": "preferences", "type": "string", "maxLength": 100, "transfer": true,
     "about": "'automatic' or a theme id from themes.json; an id the importing app does not know is ignored",
     "keys": {"mac": "defaults:appearanceSelection", "ios": "defaults:appearanceSelection", "android": "prefs:theme_id", "web": "preferences.json:theme"}},
    {"id": "highlightOutput", "part": "preferences", "type": "bool", "transfer": true,
     "keys": {"mac": "defaults:terminalHighlightOutput", "ios": "defaults:terminalHighlightOutput", "android": "prefs:highlight_output", "web": "preferences.json:highlightOutput"}},
    {"id": "readOnly", "part": "preferences", "type": "bool", "transfer": true,
     "about": "an import can turn it on, never off",
     "keys": {"mac": "defaults:readOnlyMode", "ios": "defaults:readOnlyMode", "android": "prefs:read_only", "web": "preferences.json:readOnly"}},
    {"id": "startReadOnly", "part": "preferences", "type": "bool", "transfer": true,
     "keys": {"mac": null, "ios": null, "android": "prefs:start_read_only", "web": null}},
    {"id": "autoReadOnly", "part": "preferences", "type": "string", "values": ["never", "idle5", "idle15", "background"], "transfer": true,
     "about": "never, idle5, idle15 or background",
     "keys": {"mac": null, "ios": null, "android": "prefs:auto_read_only", "web": "preferences.json:autoReadOnly"}},
    {"id": "dockerUnlockMinutes", "part": "preferences", "type": "int", "values": [0, 15, 60, 480], "transfer": true,
     "about": "15, 60, 480, or 0 for until the app quits",
     "keys": {"mac": "defaults:dockerUnlockMinutes", "ios": null, "android": null, "web": null}},
    {"id": "alertNotifications", "part": "preferences", "type": "bool", "transfer": true,
     "keys": {"mac": "defaults:alertNotifications", "ios": null, "android": null, "web": null}},
    {"id": "terminalFontSize", "part": "preferences", "type": "int", "min": 6, "max": 40, "transfer": true,
     "keys": {"mac": null, "ios": null, "android": "prefs:terminal_font_size", "web": null}},
    {"id": "servicesShowHidden", "part": "preferences", "type": "bool", "transfer": true,
     "keys": {"mac": "defaults:servicesShowHidden", "ios": "defaults:servicesShowHidden", "android": null, "web": null}},
    {"id": "filesShowHidden", "part": "preferences", "type": "bool", "transfer": true,
     "keys": {"mac": null, "ios": "defaults:filesShowHidden", "android": null, "web": null}},
    {"id": "dashboardDockerShowAll", "part": "preferences", "type": "bool", "transfer": true,
     "keys": {"mac": "defaults:dashboardDockerShowAll", "ios": null, "android": null, "web": null}},
    {"id": "vulnerabilityLookupAll", "part": "preferences", "type": "bool", "transfer": true,
     "about": "the opt-in vulnerability lookup for every server (docs/security-plan.md, S3)",
     "keys": {"mac": "defaults:osvLookupAll", "ios": "defaults:osvLookupAll", "android": "prefs:osv_lookup_all", "web": "security/settings.json:osvAll"}},
    {"id": "vulnerabilityLookup", "part": "serverSettings", "type": "bool", "transfer": true,
     "about": "the per-server opt-in, a list of server ids where the app saves it",
     "keys": {"mac": "defaults:osvLookupServers", "ios": "defaults:osvLookupServers", "android": "prefs:osv_lookup_servers", "web": "security/settings.json:osvServers"}},

    {"id": "selectedServer", "transfer": false, "reason": "which server this device has open",
     "keys": {"mac": "defaults:selectedServerID", "ios": null, "android": "prefs:selected_server", "web": null}},
    {"id": "startScreen", "transfer": false, "reason": "a launch option for screenshots",
     "keys": {"mac": "defaults:startScreen", "ios": null, "android": null, "web": null}},
    {"id": "dashboardPage", "transfer": false, "reason": "where this device's Dashboard was left",
     "keys": {"mac": "defaults:dashboardPage", "ios": "defaults:dashboardPage", "android": null, "web": null}},
    {"id": "rootTab", "transfer": false, "reason": "which tab this phone was left on",
     "keys": {"mac": null, "ios": "defaults:rootTab", "android": null, "web": null}},
    {"id": "searchCommandServer", "transfer": false, "reason": "the server last picked in Search on this phone",
     "keys": {"mac": null, "ios": "defaults:searchCommandServer", "android": null, "web": null}},
    {"id": "demoMode", "transfer": false, "reason": "demo mode must never follow a config onto a device with real servers",
     "keys": {"mac": null, "ios": "defaults:demoMode", "android": null, "web": null}},
    {"id": "firstRunDone", "transfer": false, "reason": "this device's own first launch",
     "keys": {"mac": null, "ios": null, "android": "prefs:first_run_done", "web": null}},
    {"id": "legacyTheme", "transfer": false, "reason": "read once to migrate to appearanceSelection",
     "keys": {"mac": "defaults:terminalThemeID", "ios": null, "android": null, "web": null}}
  ],
  "files": [
    {"id": "servers", "part": "servers", "transfer": true,
     "paths": {"mac": ["servers.json"], "ios": ["servers.json"], "android": ["servers.json"], "web": ["servers.json"]}},
    {"id": "knownHosts", "part": "hostKeys", "transfer": true,
     "paths": {"mac": ["~/.ssh/known_hosts"], "ios": ["known_hosts.json"], "android": ["known_hosts.json"], "web": ["known_hosts.json"]}},
    {"id": "signIn", "part": "signIn", "transfer": true,
     "about": "the method only; the secret itself is the 'secrets' part, carried only in an encrypted file",
     "paths": {"mac": [], "ios": ["sign-in.json"], "android": ["secrets/"], "web": ["keys.json", "keys/"]}},
    {"id": "preferences", "part": "preferences", "transfer": true,
     "paths": {"mac": [], "ios": [], "android": [], "web": ["preferences.json", "security/settings.json"]}},
    {"id": "iconChoices", "part": "serverSettings", "transfer": true,
     "paths": {"mac": ["app-icons/choices.json"], "ios": ["app-icons/choices.json"], "android": [], "web": []}},
    {"id": "customIcons", "part": "customIcons", "transfer": true,
     "about": "files only, never in a QR",
     "paths": {"mac": ["app-icons/custom/"], "ios": ["app-icons/custom/"], "android": [], "web": []}},
    {"id": "serviceVisibility", "part": "serverSettings", "transfer": true,
     "paths": {"mac": ["services/visibility.json"], "ios": ["services/visibility.json"], "android": [], "web": ["services/visibility.json"]}},
    {"id": "alerts", "part": "serverSettings", "transfer": true,
     "about": "only the muted alert ids travel; history and seen marks are this device's",
     "paths": {"mac": ["alerts.json"], "ios": ["alerts.json"], "android": [], "web": ["alerts.json"]}},

    {"id": "snapshots", "transfer": false, "reason": "cached readings, refreshed by the first poll",
     "paths": {"mac": ["snapshots/"], "ios": ["snapshots/"], "android": ["snapshots/"], "web": ["snapshots/"]}},
    {"id": "iconCaches", "transfer": false, "reason": "downloaded icons and catalogs, fetched again on demand",
     "paths": {"mac": ["app-icons/catalog.json", "app-icons/selfhst-index.json", "app-icons/icons/", "app-icons/icons-selfhst/", "app-icons/icons-linked/", "favicons/index.json"],
               "ios": ["app-icons/catalog.json", "app-icons/selfhst-index.json", "app-icons/icons/", "favicons/index.json"],
               "android": ["favicons/index.json"], "web": ["favicons/index.json"]}},
    {"id": "sudoPasswords", "transfer": false, "reason": "saved sudo passwords are never exported",
     "paths": {"mac": ["sudo/"], "ios": [], "android": [], "web": []}},
    {"id": "licence", "transfer": false, "reason": "the supporter licence belongs to its buyer's device and is re-entered from the email",
     "paths": {"mac": ["licence.json"], "ios": [], "android": [], "web": []}},
    {"id": "webSignIn", "transfer": false, "reason": "the web app's own admin password, TOTP, sessions and signing secret",
     "paths": {"mac": [], "ios": [], "android": [], "web": ["auth.json", "secret", "setup-token"]}},
    {"id": "webNotifications", "transfer": false, "reason": "web delivery settings hold an ntfy token and a webhook secret, and push subscriptions belong to browsers; web-to-web transfer is planned later",
     "paths": {"mac": [], "ios": [], "android": [], "web": ["notifications.json", "vapid.pem"]}},
    {"id": "bundledSpec", "transfer": false, "reason": "read-only copies of spec/ shipped inside the app, not settings",
     "paths": {"mac": [], "ios": [], "android": ["commands.json", "command-library.json", "security-checks.json", "config-transfer.json", "themes.json"], "web": []}},
    {"id": "demoFiles", "transfer": false, "reason": "demo mode's temporary files",
     "paths": {"mac": ["rackoon-demo-licence.json"], "ios": [], "android": ["demo.flag"], "web": []}}
  ]
}
